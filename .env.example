ANTHROPIC_API_KEY=your-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
MODEL_ID=your-model-id
BAIDU_SEARCH_API_KEY=

# Estimated input + output reserve; not the model's full context window.
CONTEXT_TOKEN_BUDGET=32000
# auto: native Anthropic breakpoints; DeepSeek auto-cache; compatible endpoints unchanged.
# off: no explicit markers. anthropic: opt in on a verified compatible endpoint.
PROMPT_CACHE_MODE=auto
